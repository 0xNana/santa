# Santa runs exclusively on Robinhood Chain Testnet (46630). Gas is paid in test ETH.
# Network docs: https://docs.robinhood.com/chain/connecting/
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Local deployment only. Keep these keys out of the hosted web app.
DEPLOYER_PRIVATE_KEY=
SANTA_RELAYER_ADDRESS=
SANTA_OWNER_ADDRESS=
# Required comma-separated ERC-20 addresses when deploying. These are TSLA, AMD, AMZN, NFLX and PLTR testnet tokens.
SANTA_STOCK_ADDRESSES=0xC9f9c86933092BbbfFF3CCb4b105A4A94bf3Bd4E,0x71178BAc73cBeb415514eB542a8995b82669778d,0x5884aD2f920c162CFBbACc88C9C51AA75eC09E02,0x3b8262A63d25f0477c4DDE23F83cfe22Cb768C93,0x1FBE1a0e43594b3455993B5dE5Fd0A7A266298d0

# Set BOTH after deploying SantaVault. The public address is bundled at build time.
SANTA_VAULT_ADDRESS=
NEXT_PUBLIC_SANTA_VAULT_ADDRESS=

# Hosted server: pays test ETH for claims. Must match the vault's relayer address.
RELAYER_PRIVATE_KEY=
SANTA_RELAYER_MAX_GAS_PRICE_WEI=3000000000
SANTA_RELAYER_DAILY_CAP_WEI=2000000000000000

# Privy email / Google sign-in. Configure Robinhood Chain Testnet in your Privy app.
NEXT_PUBLIC_PRIVY_APP_ID=
SANTA_PUBLIC_ORIGIN=http://localhost:3000

# Fly single-Machine storage: an absolute path on a persistent mounted volume.
# Choose SQLite OR both Upstash settings. See docs/fly-deployment.md.
SANTA_SQLITE_PATH=

# Shared records across hosts. Local development can use SANTA_ALLOW_MEMORY_STORE=1 instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SANTA_ALLOW_MEMORY_STORE=
SANTA_DEV_COUNTRY=GH
SANTA_DEV_ALLOW_UNKNOWN_COUNTRY=
PORT=3000

# Optional CLI test wallet. Never use the relayer or owner key here.
SANTA_AGENT_PRIVATE_KEY=

# Optional judge gift pool: giftId:keyIndex,... and a nonzero 32-byte seed.
SANTA_JUDGE_SEED=
SANTA_JUDGE_POOL=
# SANTA- followed by two groups of four letters/digits, excluding I, O, 0 and 1.
SANTA_JUDGE_CODE=
# Judge gift preparation from the CLI test wallet; stock is one listed testnet token address.
SANTA_JUDGE_STOCK=
SANTA_JUDGE_COUNT=10
SANTA_JUDGE_TOKENS_EACH=1
SANTA_JUDGE_START=0
# Optional source repository for docs edit links.
SANTA_REPOSITORY_URL=
